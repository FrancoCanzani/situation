{
  "name": "situation",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --parallel vite scheduler",
    "vite": "vite",
    "scheduler": "bun -e \"console.log('[scheduler] started'); while (true) { console.log('[scheduler] tick'); try { const r = await fetch('http://localhost:5173/api/ingest', { method: 'POST', signal: AbortSignal.timeout(180_000) }); console.log('[scheduler]', r.status, await r.text()) } catch (e) { console.log('[scheduler]', e instanceof Error ? e.message : e) } await Bun.sleep(60_000) }\"",
    "build": "vite build",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p src/backend",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply situation --local --persist-to .wrangler/state",
    "db:migrate": "wrangler d1 migrations apply situation --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.33",
    "ai": "^7.0.59",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "feedsmith": "^2.9.6",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@tanstack/router-plugin": "^1.168.36",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  }
}
